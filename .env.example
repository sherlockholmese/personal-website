PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=www.example.com
TRUST_CLOUDFLARE_IP_HEADER=false
CONTACT_EMAIL=contact@example.com
DOWNLOAD_ACCESS_SECRET=

# Private R2 bucket; use a token with Object Read access to this bucket.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional full S3 endpoint (for example, a jurisdiction-specific endpoint).
R2_ENDPOINT=
R2_DIST_PREFIX=dists
R2_PHOTOGRAPHY_PREFIX=photography
# Optional image CDN base URL. Its origin must serve this site's /media/photography route.
PHOTOGRAPHY_CDN_URL=
# Fixed hero image, relative to R2_PHOTOGRAPHY_PREFIX (no gallery metadata list needed).
PHOTOGRAPHY_HEADER_KEY=DSC01407_watermark.jpg
